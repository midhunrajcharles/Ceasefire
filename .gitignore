# Ceasefire — repo-root ignore rules
# Covers the Next.js frontend in Frontend/ and the FastAPI backend in backend/.
# Rename this file to `.gitignore` before `git init`.

# ─────────────────────────────────────────────────────────────
# SECRETS — the only section that actually matters
# env.example / .env.local.example are the ONLY env files tracked
# ─────────────────────────────────────────────────────────────
.env
.env.*
*.env
!env.example
!.env.local.example
secrets.json
secrets.yaml
credentials.json
service-account*.json

# Keys and tokens under any common name
*api_key*
*apikey*
*_secret*
*secret_*
*.pem
*.key
*.p12
*.pfx
*token*.txt

# Sponsor credential drops
serpapi_key*
xano_key*
foxit_credentials*
namecom_token*
doctavian_key*
nutrient_key*

# ─────────────────────────────────────────────────────────────
# DATABASE — contains real user rows, password hashes, session tokens
# ─────────────────────────────────────────────────────────────
*.db
*.db-journal
*.db-wal
*.db-shm
*.sqlite
*.sqlite3
ceasefire.db*
backend/ceasefire.db*
dump.rdb
*.dump
*.sql.gz
backups/

# ─────────────────────────────────────────────────────────────
# SCAN ARTIFACTS — contain third-party domains and evidence URLs.
# Published study output is aggregate-only with domains redacted;
# raw results stay local.
# ─────────────────────────────────────────────────────────────
study/results/raw/
study/results/*.raw.json
scans/
scan_output/
*.scan.json
serp_cache/
.cache/
cache/

# Generated notices — real legal drafts naming real parties
notices/
*.notice.pdf
*.notice.docx
backend/out/
out/notices/

# ─────────────────────────────────────────────────────────────
# Python / backend
# ─────────────────────────────────────────────────────────────
.venv/
venv/
ENV/
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
dist/
*.egg-info/
.eggs/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
coverage.xml
htmlcov/
.tox/
.ipynb_checkpoints/

# ─────────────────────────────────────────────────────────────
# Node / frontend
# ─────────────────────────────────────────────────────────────
node_modules/
.next/
out/
.pnp
.pnp.js
npm-debug.log*
yarn-error.log*
pnpm-debug.log*
.vite/
.parcel-cache/
next-env.d.ts
*.tsbuildinfo
tsconfig.tsbuildinfo

# ─────────────────────────────────────────────────────────────
# Bruno — the collection IS committed (a sponsor judge reads it),
# but the environment file holds keys.
# ─────────────────────────────────────────────────────────────
bruno/environments/*.bru
!bruno/environments/example.bru

# ─────────────────────────────────────────────────────────────
# Logs and local state
# ─────────────────────────────────────────────────────────────
*.log
logs/
budget_counter.json

# ─────────────────────────────────────────────────────────────
# Demo media — large, and the repo is public
# ─────────────────────────────────────────────────────────────
*.mp4
*.mov
*.avi
*.mkv
recordings/
demo_raw/
!demo/final/*.mp4

# ─────────────────────────────────────────────────────────────
# OS
# ─────────────────────────────────────────────────────────────
.DS_Store
Thumbs.db
desktop.ini
$RECYCLE.BIN/
*.lnk

# ─────────────────────────────────────────────────────────────
# Editors / tooling
# ─────────────────────────────────────────────────────────────
.vscode/
!.vscode/launch.json
.idea/
*.swp
*.swo
*~
.claude/settings.local.json
