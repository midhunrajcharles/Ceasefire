# Ceasefire — backend environment
# Copy to backend/.env and fill in. `.env` is gitignored; this file is not.
#   Windows:  copy env.example backend\.env
#
# The frontend has its own file: Frontend/.env.local.example → Frontend/.env.local

# ══════════════════════════════════════════════════════════════
# CORE
# ══════════════════════════════════════════════════════════════

# development | production
# Controls cookie `secure` flag, error verbosity, and docs exposure.
ENVIRONMENT=development

# Signs nothing by itself, but must be set and must be random in production.
# Generate:  python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=

# SQLite for dev. Swap to Postgres for prod — no code change required.
#   Postgres:  postgresql+psycopg://user:pass@localhost:5432/ceasefire
DATABASE_URL=sqlite:///./ceasefire.db

# Exactly one origin. Never "*" — credentials are sent with every request.
CORS_ORIGIN=http://localhost:3000

# ══════════════════════════════════════════════════════════════
# SESSIONS
# ══════════════════════════════════════════════════════════════

SESSION_COOKIE_NAME=ceasefire_session
SESSION_TTL_DAYS=30

# Auth rate limit — attempts per window, per (ip, email)
AUTH_MAX_ATTEMPTS=5
AUTH_WINDOW_MINUTES=15

# ══════════════════════════════════════════════════════════════
# SERPAPI — the tightest constraint in the system
# serpapi.com/manage-api-key   Free tier: 250 searches/month, 50/hour
# ══════════════════════════════════════════════════════════════

SERPAPI_KEY=

# Hard ceiling enforced in code. A sweep fails cleanly rather than overspending.
SEARCH_BUDGET_TOTAL=250
SEARCH_BUDGET_ALERT_AT=200

# Throughput cap for the token-bucket limiter
SERPAPI_RATE_PER_HOUR=50
SERPAPI_BURST=10

# Candidates allowed through the prefilter into the metered sweep.
# 15 keeps a demo sweep at roughly 15 searches. Raising this spends real budget.
DEMO_MAX_PERMUTATIONS=15

# Rows in serp_cache older than this are ignored on read (hours).
# Threat-verification paths bypass the cache entirely — a stale result is a
# missed detection.
SERP_CACHE_TTL_HOURS=24

# ══════════════════════════════════════════════════════════════
# EGRESS / SSRF GUARDS
# Applied to every outbound fetch of an attacker-influenced URL.
# ══════════════════════════════════════════════════════════════

EGRESS_TIMEOUT_SECONDS=8
EGRESS_MAX_REDIRECTS=3
EGRESS_MAX_RESPONSE_BYTES=2000000

# ══════════════════════════════════════════════════════════════
# SPONSOR INTEGRATIONS — all optional.
# A missing key degrades that feature gracefully and must never
# break the core sweep → findings → notice loop.
# ══════════════════════════════════════════════════════════════

# Foxit — PDF generation + eSign. developer-api.foxit.com
# Free Developer plan: 500 credits, no card required.
FOXIT_CLIENT_ID=
FOXIT_CLIENT_SECRET=
FOXIT_BASE_URL=https://na1.fusion.foxit.com

# Doctavian — conditional-template notice generation, eIDAS-aligned signatures.
# developers.doctavian.com  (open in a browser; it does not render to fetch)
DOCTAVIAN_API_KEY=
DOCTAVIAN_BASE_URL=

# Nutrient — embedded review-gate viewer. dashboard.nutrient.io/sign_up
NUTRIENT_API_KEY=

# name.com — availability + defensive registration.
# LEAVE THIS ON SANDBOX. Production registers real domains and charges money.
NAMECOM_USERNAME=
NAMECOM_TOKEN=
NAMECOM_BASE_URL=https://api.dev.name.com

# ══════════════════════════════════════════════════════════════
# LOGGING
# Never log passwords, session tokens, cookies, or API keys.
# Log the params_hash, not the params.
# ══════════════════════════════════════════════════════════════

LOG_LEVEL=INFO
