# Frontend env. Copy to .env.local
#   copy .env.local.example .env.local

# The API is reached through the Next.js rewrite in next.config.mjs, so every
# request is same-origin and the httpOnly session cookie rides along normally.
NEXT_PUBLIC_API_BASE=/api

# Where that rewrite forwards to. Only needed if the backend is not on :8000.
# BACKEND_ORIGIN=http://localhost:8000
