# Frontend env. Copy to .env.local
#   copy .env.local.example .env.local

# FastAPI backend (src/main.py)
NEXT_PUBLIC_API_BASE=http://localhost:8000

# Mock mode: 1 = serve fixture data so the UI is buildable before the backend lands.
# ALWAYS renders a visible "Demo data — not a live scan" badge.
# Set to 0 before recording the demo video.
NEXT_PUBLIC_MOCK=1
